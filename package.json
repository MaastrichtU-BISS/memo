{
  "name": "@legalblocks/bl-memo",
  "version": "0.1.0",
  "description": "Every section must cite an obligation; quotes verbatim-checked against source",
  "private": false,
  "type": "module",
  "license": "MIT",
  "legalblocks": {
    "package_id": "bluelab.memo",
    "manifest": "package.manifest.json",
    "execution_type": "backend",
    "provides_screen": "bluelab.memo"
  },
  "main": "memo.ts",
  "files": [
    "package.manifest.json",
    "src",
    "pages",
    "*.ts",
    "README.md"
  ],
  "scripts": {
    "test": "tsx memo.test.ts",
    "demo": "vite --config demo/vite.config.ts",
    "demo:build": "vite build --config demo/vite.config.ts"
  },
  "dependencies": {
    "@legalblocks/module-runtime": "^0.1.0"
  },
  "devDependencies": {
    "typescript": "^5.4.0",
    "tsx": "^4.7.0",
    "vue": "^3.4.0",
    "vite": "^5.0.0",
    "@vitejs/plugin-vue": "^5.0.0"
  }
}
